{
  "manifest_version": 3,
  "name": "X Time Spent",
  "description": "See how much time you spend on X.com",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "128": "logo.png"
  },
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png"
    },
    "default_popup": "popup.html"
  }
}
